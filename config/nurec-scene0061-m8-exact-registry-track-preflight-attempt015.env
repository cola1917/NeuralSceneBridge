# M8 exact-registry preflight.  The M6 CARLA registry contains 89 dynamic
# source tracks: 23 rigid vehicles and 66 deformable pedestrians/two-wheelers.
# Explicit layer IDs prevent NuRec from silently initializing all 382 raw
# cuboid tracks.  This is a one-step configuration probe, not a formal M8 run.
NUREC_IMAGE=nvcr.io/nvidia/nre/nre-ga:26.04
MODE=train
DATASET_DIR=outputs/ncore_dense_lidar_sweeps_v2/scene-0061
DATASET_PATH=scene-0061.json
OUTPUT_DIR=outputs/nurec_scene0061_m8_exact_registry_track_preflight_attempt_015
CACHE_DIR=.cache/nurec

CAMERA_IDS=camera_front,camera_front_left,camera_front_right,camera_back,camera_back_left,camera_back_right
LIDAR_IDS=lidar_top
CONFIG_NAME=configs/apps/prod/Hyperion-8.1/car2sim_6cam.yaml
MAX_EPOCHS=1
SAMPLES_PER_EPOCH=1
SHM_SIZE=40g
GPUS=all
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

TRACK_LABEL_SOURCES=EXTERNAL
TRACK_VEHICLE_CLASSES="automobile,bicycle,bus,heavy_truck,motorcycle,Other Vehicle - Construction Vehicle"
TRACK_PEDESTRIAN_CLASSES=pedestrian
REQUIRE_DYNAMIC_TRACKS=1
NCORE_VALIDATION_IMAGE=nsb/ncore-converter:2026-07-17-dense-v1
TRACK_MIN_DISTANCE_M=0
TRACK_MIN_DISPLACEMENT_M=0
TRACK_MIN_SPEED_MS=0
TRACK_USE_DISPLACEMENT_AND_DISTANCE=1
NCORE_MIN_TRACK_DISPLACEMENT_M=0
NCORE_MIN_TRACK_SPEED_MS=0

