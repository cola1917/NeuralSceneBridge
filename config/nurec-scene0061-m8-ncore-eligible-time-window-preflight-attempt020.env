# Retry 019 with the object-class contract made explicit at the leaf recipe.
# This makes the 87-track M8 preflight independent of inherited shell state.
source config/nurec-scene0061-m8-ncore-eligible-time-window-preflight-attempt018.env

OUTPUT_DIR=outputs/nurec_scene0061_m8_ncore_eligible_time_window_preflight_attempt_020
TRACK_VEHICLE_CLASSES="automobile,bicycle,bus,heavy_truck,motorcycle,Other Vehicle - Construction Vehicle"
TRACK_PEDESTRIAN_CLASSES=pedestrian

# The selected registry contains 23 vehicle/two-wheel tracks and 64 pedestrians.
EXPECTED_MIN_USDZ_TRACKS=87
EXPECTED_MIN_USDZ_VEHICLES=23
EXPECTED_MIN_USDZ_PEDESTRIANS=64
