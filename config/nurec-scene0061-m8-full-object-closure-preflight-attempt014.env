# M8 closure preflight. M6 physically registers 89 dynamic objects, while the
# default NuRec classifier only retained 50. Disable its distance, displacement
# and speed thresholds so the actual NuRec layer inventory can be compared with
# the complete CARLA registry before any 40k formal reconstruction is launched.
NUREC_IMAGE=nvcr.io/nvidia/nre/nre-ga:26.04
MODE=train
DATASET_DIR=outputs/ncore_dense_lidar_sweeps_v2/scene-0061
DATASET_PATH=scene-0061.json
OUTPUT_DIR=outputs/nurec_scene0061_m8_full_object_closure_preflight_attempt_014
CACHE_DIR=.cache/nurec

CAMERA_IDS=camera_front,camera_front_left,camera_front_right,camera_back,camera_back_left,camera_back_right
LIDAR_IDS=lidar_top
CONFIG_NAME=configs/apps/prod/Hyperion-8.1/car2sim_6cam.yaml
MAX_EPOCHS=1
SAMPLES_PER_EPOCH=1
SHM_SIZE=40g
GPUS=all
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

TRACK_LABEL_SOURCES=EXTERNAL
TRACK_VEHICLE_CLASSES="automobile,bicycle,bus,heavy_truck,motorcycle,Other Vehicle - Construction Vehicle"
TRACK_PEDESTRIAN_CLASSES=pedestrian
REQUIRE_DYNAMIC_TRACKS=1
NCORE_VALIDATION_IMAGE=nsb/ncore-converter:2026-07-17-dense-v1
TRACK_MIN_DISTANCE_M=0
TRACK_MIN_DISPLACEMENT_M=0
TRACK_MIN_SPEED_MS=0
TRACK_USE_DISPLACEMENT_AND_DISTANCE=1
NCORE_MIN_TRACK_DISPLACEMENT_M=0
NCORE_MIN_TRACK_SPEED_MS=0

REQUIRE_LIDAR_SUPERVISION=1
REQUIRE_RENDERABLE_LIDAR=1
N_TRAIN_SAMPLE_LIDAR_RAYS=2048
RATIO_LIDAR_SAMPLES=1.0
LIDAR_LOSS_WEIGHT=0.005
LIDAR_INTENSITY_LOSS_WEIGHT=1.0
LIDAR_RAYDROP_LOSS_WEIGHT=0.1

DYNAMIC_TRACK_POINTS_PER_TRACK=1500000
DYNAMIC_TRACK_POINTS_PER_LAYER=9000000
DYNAMIC_TRACK_KEEP_ALL_POSES=1
