# M8 formal recipe: uses the closure-proven 87 NCore-replayable registry tracks.
# The two singleton source pedestrians remain static source-scene obstacles with
# CARLA colliders; they are intentionally not replayed as NCore dynamic tracks.
source config/nurec-scene0061-m8-ncore-eligible-registry-preflight-attempt016.env

OUTPUT_DIR=outputs/nurec_scene0061_m8_ncore_eligible_registry_formal_attempt_017
SAMPLES_PER_EPOCH=40000
EXPECTED_GLOBAL_STEP=40000

# Dynamic initialization must use only poses contemporaneous with each LiDAR
# frame. This preserves time alignment and avoids repeatedly matching every
# pose from every actor to every LiDAR frame.
DYNAMIC_TRACK_KEEP_ALL_POSES=0
DYNAMIC_TRACK_INIT_STEP_FRAME=1

EXPECTED_MIN_USDZ_TRACKS=87
EXPECTED_MIN_USDZ_VEHICLES=23
EXPECTED_MIN_USDZ_PEDESTRIANS=64
