# 018 proves that the full NCore-eligible registry can initialize as two
# time-windowed dynamic layers. It is intentionally a bounded-resource
# preflight; the 40k formal recipe remains attempt 017.
source config/nurec-scene0061-m8-ncore-eligible-registry-preflight-attempt016.env

OUTPUT_DIR=outputs/nurec_scene0061_m8_ncore_eligible_time_window_preflight_attempt_018
SAMPLES_PER_EPOCH=1
EXPECTED_GLOBAL_STEP=1

DYNAMIC_TRACK_KEEP_ALL_POSES=0
DYNAMIC_TRACK_INIT_STEP_FRAME=1
DYNAMIC_TRACK_POINTS_PER_TRACK=100000
DYNAMIC_TRACK_POINTS_PER_LAYER=2000000

EXPECTED_MIN_USDZ_TRACKS=87
EXPECTED_MIN_USDZ_VEHICLES=23
EXPECTED_MIN_USDZ_PEDESTRIANS=64
