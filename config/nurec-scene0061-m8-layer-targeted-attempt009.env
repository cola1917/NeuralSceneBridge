# M8 multi-actor initialization preflight. This is deliberately a one-step
# candidate: it verifies that the four vehicle and two pedestrian layers keep
# fragmented dynamic point clouds before an expensive full-scene rebuild.
# It is not an M8 promotion artifact.
NUREC_IMAGE=nvcr.io/nvidia/nre/nre-ga:26.04
MODE=train
DATASET_DIR=outputs/ncore_dense_lidar_sweeps_v2/scene-0061
DATASET_PATH=scene-0061.json
OUTPUT_DIR=outputs/nurec_scene0061_m8_layer_targeted_attempt_009
CACHE_DIR=.cache/nurec

CAMERA_IDS=camera_front,camera_front_left,camera_front_right,camera_back,camera_back_left,camera_back_right
LIDAR_IDS=lidar_top
CONFIG_NAME=configs/apps/prod/Hyperion-8.1/car2sim_6cam.yaml
MAX_EPOCHS=1
SAMPLES_PER_EPOCH=1
SHM_SIZE=40g
GPUS=all
CUDA_VISIBLE_DEVICES=0

TRACK_LABEL_SOURCES=EXTERNAL
REQUIRE_DYNAMIC_TRACKS=1
NCORE_VALIDATION_IMAGE=nsb/ncore-converter:2026-07-17-dense-v1
DYNAMIC_RIGID_TRACK_IDS=4080c30aa7104d91ad005a50b18f6108,56a71c208ac6472f90b6a82529a6ce61,e3c5b72c12c34c85aac247734ad83bef,e91afa15647c4c4994f19aeb302c7179
DYNAMIC_TRACK_IDS=ac2622bcaa704aa4993efdfde06a4235,f4b2632a2f9947da9f7959a3bd0e322c

REQUIRE_LIDAR_SUPERVISION=1
REQUIRE_RENDERABLE_LIDAR=1
N_TRAIN_SAMPLE_LIDAR_RAYS=2048
RATIO_LIDAR_SAMPLES=1.0
LIDAR_LOSS_WEIGHT=0.005
LIDAR_INTENSITY_LOSS_WEIGHT=1.0
LIDAR_RAYDROP_LOSS_WEIGHT=0.1

# NuRec downsamples each fragmented track cloud independently. Keep a budget
# proven for e91 per track, and a layer ceiling large enough for all six tracks.
DYNAMIC_TRACK_POINTS_PER_TRACK=1500000
DYNAMIC_TRACK_POINTS_PER_LAYER=9000000
DYNAMIC_TRACK_KEEP_ALL_POSES=1
